{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Server.Kestrel": "Error"
    }
  },
  "AllowedHosts": "*",
  "ApiDocs": {
    "Enabled": true,
    "DefaultUi": "scalar",
    "SwaggerRoutePrefix": "swagger",
    "ScalarRoutePrefix": "scalar",
    "DocumentTitle": "GrpcHttp3Demo API Docs"
  },
  "Session": {
    "HeartbeatIntervalSeconds": 3,
    "TimeoutSeconds": 8,
    "CleanupCheckIntervalMs": 1000
  },
  "Kestrel": {
    "Endpoints": {
      "GrpcHttps": {
        "Url": "https://*:7777",
        "Protocols": "Http1AndHttp2",
        "Certificate": {
          "Path": "Configs/Certificate/grpc-dev.eifuture.com.pfx",
          "Password": ""
        }
      }
    }
  },
  "MediaServer": {
    "UdpPort": 7778,
    "UdpSocket": {
      "ReceiveBufferBytes": 8388608,
      "SendBufferBytes": 8388608,
      "ReceiveDatagramBufferBytes": 65535,
      "ReceivePipelineCount": 4,
      "NonBlockingSend": true
    },
    "UdpControlTimeoutSeconds": 15,
    "UdpRescueCooldownSeconds": 10,
    "UdpMaxRescues": 3
  },
  "ClientApiAuth": {
    "AdminUsername": "admin",
    "AdminPassword": "Admin!20260523",
    "TokenTtlMinutes": 480
  },
  "Pairing": {
    "AutoSubscribe": {
      "Rules": [
        {
          "PublisherRole": "Robot",
          "SubscriberRole": "Vr",
          "MediaKinds": ["Video", "Audio"]
        },
        {
          "PublisherRole": "Vr",
          "SubscriberRole": "Robot",
          "MediaKinds": ["Audio", "Pose", "Feedback"]
        }
      ]
    }
  }
}
